        "timestamp": datetime.now().isoformat()
    }

@app.post("/support/inquiry", response_model=InquiryResponse)
async def process_inquiry(request: InquiryRequest):
    """Process a customer support inquiry"""
    try:
        if crew is None:
            raise HTTPException(status_code=503, detail="Service not initialized")
        
        # Prepare inputs
        inputs = {
            'customer': request.customer,
            'person': request.person,
            'inquiry': request.inquiry
        }
        
        # Process with crew
        result = crew.kickoff(inputs)
        
        return InquiryResponse(
            success=True,
            response=result['final_response'],
            processing_time=result['processing_time'],
            agent_activities=result['activities']
        )
    
    except Exception as e:
        return InquiryResponse(
            success=False,
            error=f"Error processing inquiry: {str(e)}"
        )

@app.post("/support/clear-memory")
async def clear_memory():
    """Clear conversation memory"""
    if crew and crew.memory:
        crew.memory.clear()
        return {"status": "success", "message": "Memory cleared"}
    return {"status": "error", "message": "Memory not enabled"}


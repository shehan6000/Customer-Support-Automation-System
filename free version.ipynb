# SECTION 7: CREW (MULTI-AGENT SYSTEM)
# ============================================================================

class SupportCrew:
    """Multi-agent crew for customer support"""
    
    def __init__(self, verbose: bool = False, enable_memory: bool = True):
        self.verbose = verbose
        self.enable_memory = enable_memory
        
        # Initialize tools
        self.tools = {
            'search': FreeWebSearchTool(max_results=Config.SEARCH_MAX_RESULTS),
            'scraper': FreeWebScraperTool()
        }
        
        # Initialize memory
        self.memory = ConversationMemory() if enable_memory else None
        
        # Initialize agents
        self.support_agent = SupportAgent(tools=self.tools, verbose=verbose)
        self.qa_agent = QualityAssuranceAgent(verbose=verbose)
        
        self.all_activities = []
    
    def kickoff(self, inputs: Dict[str, str]) -> Dict[str, Any]:
        """Start the crew workflow"""
        
        start_time = time.time()
        
        customer = inputs['customer']
        person = inputs['person']
        inquiry = inputs['inquiry']
        
        if self.verbose:
            print(f"\n{'='*60}")
            print(f"Processing inquiry from {customer} ({person})")
            print(f"Inquiry: {inquiry}")
            print(f"{'='*60}\n")
        
        # Get conversation context
        context = ""
        if self.memory:
            context = self.memory.get_context()
        
        # Step 1: Support agent processes inquiry
        if self.verbose:
            print("\n[STEP 1] Support Agent processing inquiry...")
        
        draft_response = self.support_agent.process_inquiry(
            customer, person, inquiry, context
        )
        
        # Step 2: QA agent reviews response
        if self.verbose:
            print("\n[STEP 2] QA Agent reviewing response...")
        
        final_response = self.qa_agent.review_response(
            customer, person, inquiry, draft_response
        )
        
        # Store in memory
        if self.memory:
            self.memory.add("user", inquiry)
            self.memory.add("assistant", final_response)
        
        # Collect activities
        self.all_activities = (
            self.support_agent.activities + 
            self.qa_agent.activities
        )
        
        processing_time = time.time() - start_time
        
        if self.verbose:
            print(f"\n{'='*60}")
            print(f"Processing completed in {processing_time:.2f}s")
            print(f"{'='*60}\n")
        
        return {
            'final_response': final_response,
            'processing_time': processing_time,
            'activities': self.all_activities
        }


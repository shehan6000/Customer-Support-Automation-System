class BaseAgent:
    """Base agent class using free Groq API"""
    
    def __init__(self, role: str, goal: str, backstory: str, verbose: bool = False):
        self.role = role
        self.goal = goal
        self.backstory = backstory
        self.verbose = verbose
        self.activities = []
    
    def think(self, prompt: str, context: str = "") -> str:
        """Use Groq's free LLM to process the prompt"""
        try:
            system_message = f"""You are a {self.role}.
Your goal: {self.goal}
Background: {self.backstory}

{context}"""
            
            messages = [
                {"role": "system", "content": system_message},
                {"role": "user", "content": prompt}
            ]
            
            if self.verbose:
                print(f"\n[{self.role}] Thinking...")
            
            completion = groq_client.chat.completions.create(
                model=Config.GROQ_MODEL,
                messages=messages,
                temperature=0.7,
                max_tokens=2000
            )
            
            response = completion.choices[0].message.content
            
            # Log activity
            self.activities.append({
                "agent": self.role,
                "action": "thinking",
                "timestamp": datetime.now().isoformat()
            })
            
            return response
        
        except Exception as e:
            error_msg = f"Error in {self.role}: {str(e)}"
            print(error_msg)
            return error_msg

class SupportAgent(BaseAgent):
    """Customer support agent with research capabilities"""
    
    def __init__(self, tools: Dict[str, Any], verbose: bool = False):
        super().__init__(
            role="Senior Support Representative",
            goal="Provide the best support response to help the customer",
            backstory="""You are an expert customer support representative with years of 
            experience helping customers with technical and product questions. You are 
            friendly, knowledgeable, and always go the extra mile to ensure customer 
            satisfaction. You can search the web and scrape documentation when needed.""",
            verbose=verbose
        )
        self.tools = tools
    
    def process_inquiry(self, customer: str, person: str, inquiry: str, context: str = "") -> str:
        """Process a customer inquiry"""
        
        # First, determine if we need to search for information
        search_decision_prompt = f"""Customer: {customer}
Person: {person}
Inquiry: {inquiry}

Should we search the web for information to answer this inquiry? 
Respond with only 'YES' or 'NO' and a brief reason."""
        
        search_decision = self.think(search_decision_prompt, context)
        
        research_info = ""
        if "YES" in search_decision.upper():
            if self.verbose:
                print(f"[{self.role}] Searching for information...")
            
            # Perform web search
            search_results = self.tools['search'].search(inquiry)
            research_info = self.tools['search'].format_results(search_results)
            
            self.activities.append({
                "agent": self.role,
                "action": "web_search",
                "query": inquiry,
                "results_count": len(search_results),
                "timestamp": datetime.now().isoformat()
            })
        
        # Generate response
        response_prompt = f"""Create a comprehensive support response for:

Customer: {customer}
Contact Person: {person}
Inquiry: {inquiry}

{context}

{research_info if research_info else 'Use your knowledge to answer.'}

Provide a friendly, professional, and complete response that addresses all aspects 
of the inquiry. Be specific and helpful."""
        
        response = self.think(response_prompt)
        
        return response

class QualityAssuranceAgent(BaseAgent):
    """QA agent to review and improve responses"""
    
    def __init__(self, verbose: bool = False):
        super().__init__(
            role="Support Quality Assurance Specialist",
            goal="Ensure all responses meet quality standards",
            backstory="""You are a meticulous QA specialist who reviews customer support 
            responses. You ensure responses are accurate, complete, professional, and 
            friendly. You check for tone, clarity, completeness, and correctness.""",
            verbose=verbose
        )
    
    def review_response(self, customer: str, person: str, inquiry: str, 
                       draft_response: str) -> str:
        """Review and improve a draft response"""
        
        review_prompt = f"""Review this customer support response:

Customer: {customer}
Person: {person}
Original Inquiry: {inquiry}

Draft Response:
{draft_response}

Your tasks:
1. Check if the response fully addresses the inquiry
2. Verify the tone is friendly and professional
3. Ensure technical accuracy
4. Check for completeness
5. Improve clarity if needed

Provide the FINAL APPROVED RESPONSE that is ready to send to the customer. 
Do not include any review notes or analysis, just the final response."""
        
        final_response = self.think(review_prompt)
        
        self.activities.append({
            "agent": self.role,
            "action": "quality_review",
            "timestamp": datetime.now().isoformat()
        })
        
        return final_response

